{
  "name": "xantho-ai",
  "version": "1.1.0",
  "author": "Dr Floris CHABRUN, Laboratory of Biochemistry and Molecular Biology, University Hospital of Angers",
  "description": "Analyse spectrophotométrique du LCR",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc && electron-builder --win portable"
  },
  "build": {
    "appId": "fr.chu-angers.xanthoai",
    "productName": "Analyse spectrophotométrique du LCR",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
	  "icon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.3.0"
  }
}